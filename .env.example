# Ubicación desde la que partirá el análisis (WGS84).
LATITUDE=19.4326
LONGITUDE=-99.1332

# Zona y horizonte que se analizan.
WEATHER_RADIUS_KM=5
FORECAST_HOURS=8
DRY_WINDOW_HOURS=2

# Opcional: completa ambos valores para habilitar los envíos por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Long polling del bot al ejecutar: python3 main.py --listen-telegram
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Opcional: tiempo máximo de cada petición HTTP.
REQUEST_TIMEOUT_SECONDS=15
